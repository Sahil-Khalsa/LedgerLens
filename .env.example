# ── EDGAR ────────────────────────────────────────────────────────────────────
# Required. SEC blocks requests without a real User-Agent + contact info.
EDGAR_USER_AGENT="LedgerLens Your Name your@email.com"

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+psycopg://ledgerlens:ledgerlens@localhost:5432/ledgerlens"

# ── Data paths ────────────────────────────────────────────────────────────────
DATA_DIR="./data"

# ── LLM / model providers ─────────────────────────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
HF_TOKEN=""                                    # for gated HuggingFace models

COLPALI_CHECKPOINT="vidore/colpali-v1.2"
VLM_MODEL="Qwen/Qwen2-VL-7B-Instruct"
PLANNER_MODEL="gpt-4o-mini"
SYNTHESIZER_MODEL="gpt-4o"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"   # text baseline only

# ── API auth ──────────────────────────────────────────────────────────────────
# Comma-separated SHA-256 hashes of valid API keys. Generate with:
#   uv run python -m api.auth --generate
API_KEY_HASHES=""
FRONTEND_URL="http://localhost:3000"

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_STAGE1_N=50
RETRIEVAL_TOP_K=5

# ── Eval gate thresholds ──────────────────────────────────────────────────────
# Set these to just below your measured baseline AFTER you have a real number.
# Do not set aspirational values before running the eval.
EVAL_MIN_NUMERIC_EM=0.0
EVAL_MAX_HALLUCINATION=1.0

# ── Observability (Langfuse) ──────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
